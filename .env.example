# 复制为 .env 后可用于裸机 docker compose 变量替换（当前 compose 已内置默认值）
POSTGRES_PASSWORD=recovery_pw
DATABASE_URL=postgresql://recovery:recovery_pw@db:5432/caldb
COORD_SQLITE_PATH=/data/coord/coordinator.db
WEB_SQLITE_PATH=/data/web/recovery.db
ENABLE_CRASH_DEMO=true
# 发布台总名额（1..max_prepared_transactions）。演示固定 2 席：1 普通 + 1 抢修预留。
PUBLISH_MAX_SLOTS=2
# 预留席只对该指定抢修设备号开放（多台可用 EMERGENCY_DEVICE_NOS=a,b,c）
EMERGENCY_DEVICE_NO=DEV-EMG-01
# 普通网页下单等参数行锁的最长毫秒，0=死等；一键演示后台任务不受此限
PUBLISH_LOCK_TIMEOUT_MS=15000
